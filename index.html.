<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Para ti ❤️</title>
<style>
body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #210016, #7d123f, #160016);
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
}
.heart {
  font-size: 115px;
  cursor: pointer;
  animation: latir 1s infinite;
  user-select: none;
}
@keyframes latir {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.18); }
}
h2 { font-size: 23px; }
p { font-size: 17px; padding: 0 20px; }
</style>
</head>
<body>
<div class="heart" id="corazon">❤️</div>
<h2>Tócame 5 veces... 💕</h2>
<p id="mensaje">Tengo algo muy especial para ti.</p>
<script>
let toques = 0;
const corazon = document.getElementById("corazon");
corazon.addEventListener("click", function() {
  toques++;
  if (toques < 5) {
    document.getElementById("mensaje").textContent =
      "Un toque más de amor... ❤️ " + toques + "/5";
  } else {
    document.getElementById("mensaje").textContent =
      "Cada segundo recuerda lo especial que eres para mí. 💌";
    setTimeout(function() {
      window.location.href = "https://canva.link/9hq5qdmpt31brsk";
    }, 1800);
  }
});
</script>
</body>
</html>
